{
  "name": "apkcatalog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual Android app & game catalog aggregator (static, Astro).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:ru": "SITE_LANG=ru astro build --outDir dist/ru",
    "build:en": "SITE_LANG=en astro build --outDir dist/en",
    "build:tr": "SITE_LANG=tr astro build --outDir dist/tr",
    "build:all": "npm run build:ru && npm run build:en && npm run build:tr && npm run build:uz",
    "preview": "astro preview",
    "astro": "astro",
    "discovery": "node scripts/discovery.js",
    "fetch-details": "node scripts/fetch-details.js",
    "data:validate": "node scripts/validate-data.js",
    "smoke": "node scripts/smoke.js",
    "seed": "node scripts/seed-sample-data.js",
    "test": "npm run data:validate && npm run smoke",
    "build:uz": "SITE_LANG=uz astro build --outDir dist/uz",
    "add-apk": "node scripts/add-apk.js",
    "fdroid": "node scripts/fdroid-import.js",
    "github": "node scripts/github-import.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@vercel/edge": "^1.3.3",
    "astro": "^5.6.1",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "adbkit-apkreader": "^3.2.0",
    "google-play-scraper": "^10.0.0",
    "yauzl": "^2.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
