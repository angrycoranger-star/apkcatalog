---
export const prerender = false;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>apk4orge · Отзывы</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 0; background: #0b1120; color: #e2e8f0; }
      header { display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; border-bottom: 1px solid #1e293b; }
      header b { font-size: 16px; }
      header nav a { color: #94a3b8; font-size: 13px; text-decoration: none; margin-left: 16px; }
      main { max-width: 820px; margin: 0 auto; padding: 24px 20px 60px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .sub { color: #94a3b8; font-size: 13px; margin: 0 0 20px; }
      .item { display: flex; gap: 12px; padding: 12px 14px; border: 1px solid #1e293b;
        border-radius: 12px; margin-top: 10px; background: #0f1626; align-items: flex-start; }
      .item .meta { min-width: 0; flex: 1; }
      .item .top { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 13px; }
      .item .name { font-weight: 600; }
      .stars { color: #fbbf24; letter-spacing: 1px; }
      .item .slug { color: #94a3b8; font-size: 12px; }
      .item .date { color: #64748b; font-size: 12px; }
      .item .text { margin-top: 6px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
      .item a.card { color: #a5b4fc; font-size: 12px; text-decoration: none; }
      .del { flex: none; font-size: 13px; padding: 7px 12px; border-radius: 9px; border: 1px solid #7f1d1d;
        background: #131c31; color: #fca5a5; cursor: pointer; }
      .status { margin-top: 16px; font-size: 14px; min-height: 20px; }
      .status.err { color: #f87171; }
      .empty { color: #64748b; font-size: 14px; margin-top: 24px; }
    </style>
  </head>
  <body>
    <header>
      <b>apk4orge · отзывы</b>
      <nav>
        <a href="/">Добавить</a>
        <a href="/manage">Мои приложения</a>
        <a href="/serp">Позиции</a>
        <a href="#" id="logout">Выйти</a>
      </nav>
    </header>
    <main>
      <h1>Отзывы посетителей</h1>
      <p class="sub">Свежие комментарии и оценки со всех карточек. Спам или лишнее — удаляй; исчезнет со страницы сразу.</p>
      <div id="list"></div>
      <div class="status" id="status">Загрузка…</div>
    </main>

    <script>
      const $ = (id) => document.getElementById(id);
      const setStatus = (m, k) => { const s = $('status'); s.textContent = m || ''; s.className = 'status ' + (k || ''); };
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const stars = (n) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);

      $('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/login';
      });

      async function load() {
        setStatus('Загрузка…');
        try {
          const res = await fetch('/api/reviews-recent');
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка');
          render(data.comments || []);
          setStatus('');
        } catch (err) { setStatus(err.message || 'Ошибка', 'err'); }
      }

      function render(rows) {
        const list = $('list');
        if (!rows.length) { list.innerHTML = '<p class="empty">Пока нет ни одного отзыва.</p>'; return; }
        list.innerHTML = rows.map((c) => `
          <div class="item" data-slug="${esc(c.slug)}" data-id="${esc(c.id)}">
            <div class="meta">
              <div class="top">
                <span class="name">${esc(c.name || 'Гость')}</span>
                <span class="stars">${stars(c.rating || 0)}</span>
                <span class="date">${c.at ? new Date(c.at).toLocaleString() : ''}</span>
              </div>
              <div class="slug"><a class="card" href="/edit?slug=${encodeURIComponent(c.slug)}">/app/${esc(c.slug)}/</a></div>
              ${c.text ? `<div class="text">${esc(c.text)}</div>` : ''}
            </div>
            <button class="del" data-del>Удалить</button>
          </div>`).join('');

        list.querySelectorAll('[data-del]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const item = btn.closest('.item');
            remove(item.dataset.slug, item.dataset.id);
          });
        });
      }

      async function remove(slug, id) {
        if (!confirm('Удалить этот отзыв?')) return;
        setStatus('Удаление…');
        try {
          const res = await fetch('/api/review-delete', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, id })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка');
          await load();
        } catch (err) { setStatus(err.message || 'Ошибка', 'err'); }
      }

      load();
    </script>
  </body>
</html>
