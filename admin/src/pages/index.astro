---
import { categoryChoices } from '../lib/record.js';
export const prerender = false;
const categories = categoryChoices();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>apk4orge · Загрузка приложения</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 0; background: #0b1120; color: #e2e8f0; }
      header { display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; border-bottom: 1px solid #1e293b; }
      header b { font-size: 16px; }
      header a { color: #94a3b8; font-size: 13px; text-decoration: none; }
      main { max-width: 640px; margin: 0 auto; padding: 24px 20px 60px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .sub { color: #94a3b8; font-size: 13px; margin: 0 0 24px; }
      label { display: block; font-size: 13px; margin: 16px 0 6px; color: #cbd5e1; }
      input, select, textarea { width: 100%; box-sizing: border-box; border-radius: 10px; border: 1px solid #334155;
        background: #131c31; color: #e2e8f0; padding: 10px 12px; font-size: 15px; font-family: inherit; }
      textarea { min-height: 96px; resize: vertical; }
      input[type=file] { padding: 8px; }
      button { margin-top: 24px; width: 100%; height: 46px; border: 0; border-radius: 10px; background: #4f46e5;
        color: #fff; font-weight: 600; font-size: 15px; cursor: pointer; }
      button:disabled { opacity: .6; cursor: default; }
      .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .status { margin-top: 18px; font-size: 14px; min-height: 20px; }
      .status.ok { color: #34d399; } .status.err { color: #f87171; }
      .bar { height: 6px; border-radius: 6px; background: #1e293b; overflow: hidden; margin-top: 8px; display: none; }
      .bar > i { display: block; height: 100%; width: 0; background: #4f46e5; transition: width .2s; }
      .hint { color: #64748b; font-size: 12px; margin-top: 4px; }
      header nav a { margin-left: 16px; }
      fieldset { border: 1px solid #1e293b; border-radius: 12px; padding: 2px 14px 16px; margin-top: 24px; }
      legend { font-size: 12px; color: #94a3b8; padding: 0 6px; }
      .checkrow { display: flex; align-items: center; gap: 9px; margin-top: 14px; }
      .checkrow input[type=checkbox] { width: 18px; height: 18px; }
      .checkrow label { margin: 0; }
      .hidden { display: none; }
      .genrow { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
      .genbtn { margin: 0; width: auto; height: 38px; padding: 0 16px; background: #131c31; color: #a5b4fc;
        border: 1px solid #4f46e5; border-radius: 10px; font-size: 14px; font-weight: 500; }
      .genbtn:disabled { opacity: .6; }
      .genstatus { font-size: 13px; color: #94a3b8; }
      .genstatus.err { color: #f87171; }
      .genstatus.ok { color: #34d399; }
    </style>
  </head>
  <body>
    <header>
      <b>apk4orge · загрузка</b>
      <nav>
        <a href="/manage">Мои приложения</a>
        <a href="/collections">Подборки</a>
        <a href="#" id="logout">Выйти</a>
      </nav>
    </header>
    <main>
      <h1>Добавить приложение</h1>
      <p class="sub">Файл и скриншоты уходят напрямую в хранилище, карточка появится на сайте через 1–2 минуты после сборки.</p>

      <form id="f">
        <label for="name">Название</label>
        <input id="name" name="name" type="text" required maxlength="120" />

        <div class="row">
          <div>
            <label for="developer">Разработчик</label>
            <input id="developer" name="developer" type="text" maxlength="120" />
          </div>
          <div>
            <label for="category">Категория</label>
            <select id="category" name="category" required>
              <option value="" disabled selected>Выберите…</option>
              {categories.map((c) => <option value={c.slug}>{c.label}</option>)}
            </select>
          </div>
        </div>

        <label for="description">Описание</label>
        <textarea id="description" name="description" maxlength="4000" placeholder="Пара абзацев о приложении. Показывается на карточке."></textarea>
        <div class="genrow">
          <button type="button" id="gen" class="genbtn">✨ Сгенерировать через Claude</button>
          <span class="genstatus" id="genstatus"></span>
        </div>
        <p class="hint">Сгенерирует SEO-описание сразу на 4 языках из названия, разработчика и категории. В поле показывается русский вариант — правь его; остальные языки сохранятся автоматически.</p>

        <label for="apk">APK-файл</label>
        <input id="apk" name="apk" type="file" accept=".apk,application/vnd.android.package-archive" required />
        <p class="hint">Версия, размер, минимальный Android, разрешения и SHA-256 считаются из файла автоматически.</p>

        <label for="shots">Скриншоты (по желанию, до 8)</label>
        <input id="shots" name="shots" type="file" accept="image/png,image/jpeg,image/webp" multiple />

        <fieldset>
          <legend>Веб-версия</legend>
          <div class="checkrow">
            <input id="hasWeb" type="checkbox" />
            <label for="hasWeb">Есть веб-версия (кнопка «Играть в браузере», в т.ч. для iPhone)</label>
          </div>
          <div id="webWrap" class="hidden">
            <label for="webUrl">Ссылка на веб-версию</label>
            <input id="webUrl" type="url" placeholder="https://…" />
          </div>
        </fieldset>

        <fieldset>
          <legend>Продвижение на главной</legend>
          <div class="checkrow">
            <input id="featured" type="checkbox" />
            <label for="featured">Показывать в блоке «Рекомендуем» на главной</label>
          </div>
          <div class="checkrow">
            <input id="pinned" type="checkbox" />
            <label for="pinned">Закреплять вверху разделов (Популярное / Новое)</label>
          </div>
          <label for="promoOrder">Порядок (меньше — выше; для «Рекомендуем» и закрепления)</label>
          <input id="promoOrder" type="number" value="100" min="0" step="1" />
        </fieldset>

        <fieldset>
          <legend>Оценка</legend>
          <div class="row">
            <div>
              <label for="rating">Рейтинг (0–5)</label>
              <input id="rating" type="number" min="0" max="5" step="0.1" placeholder="напр. 4.7" />
            </div>
            <div>
              <label for="ratingsCount">Кол-во оценок</label>
              <input id="ratingsCount" type="number" min="0" step="1" placeholder="напр. 1200" />
            </div>
          </div>
          <p class="hint">Необязательно. Задаёт звёзды на карточке и влияет на «Популярное / Высокий рейтинг». Оставь пустым — звёзд не будет.</p>
        </fieldset>

        <div class="bar" id="bar"><i id="barfill"></i></div>
        <button id="submit" type="submit">Опубликовать</button>
        <div class="status" id="status"></div>
      </form>
    </main>

    <script>
      import { upload } from '@vercel/blob/client';

      const $ = (id) => document.getElementById(id);
      const setStatus = (msg, kind) => { const s = $('status'); s.textContent = msg; s.className = 'status ' + (kind || ''); };
      const bar = $('bar'), fill = $('barfill');

      $('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/login';
      });

      $('hasWeb').addEventListener('change', (e) => {
        $('webWrap').classList.toggle('hidden', !e.target.checked);
        if (!e.target.checked) $('webUrl').value = '';
      });

      // Claude-generated per-language descriptions (ru shown in the field, all four submitted).
      let generated = null;
      const catLabel = () => $('category').selectedOptions[0]?.textContent?.trim() || '';
      $('gen').addEventListener('click', async () => {
        const name = $('name').value.trim();
        if (!name) { const s = $('genstatus'); s.textContent = 'Сначала введите название'; s.className = 'genstatus err'; return; }
        const btn = $('gen'), s = $('genstatus');
        btn.disabled = true; s.textContent = 'Claude пишет описание…'; s.className = 'genstatus';
        try {
          const res = await fetch('/api/generate', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ name, developer: $('developer').value.trim(), categoryLabel: catLabel() })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка генерации');
          generated = data.translations || null;
          if (generated && generated.ru) $('description').value = generated.ru;
          s.textContent = 'Готово — сгенерировано на 4 языках. Правь русский при желании.'; s.className = 'genstatus ok';
        } catch (err) {
          s.textContent = err.message || 'Ошибка'; s.className = 'genstatus err';
        } finally {
          btn.disabled = false;
        }
      });

      async function uploadOne(file, folder) {
        const safe = file.name.replace(/[^a-zA-Z0-9._-]+/g, '_');
        const res = await upload(`${folder}/${safe}`, file, {
          access: 'public',
          handleUploadUrl: '/api/blob-token'
        });
        return res.url;
      }

      $('f').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const btn = $('submit');
        const apkFile = $('apk').files[0];
        if (!apkFile) return;
        btn.disabled = true; setStatus('Загрузка файла…'); bar.style.display = 'block'; fill.style.width = '15%';

        // Keep any Russian edits made after generation; other languages stay as generated.
        const descriptions = generated ? { ...generated, ru: $('description').value.trim() } : undefined;

        try {
          const apkUrl = await uploadOne(apkFile, 'apk');
          fill.style.width = '55%';

          const shotFiles = Array.from($('shots').files).slice(0, 8);
          const screenshots = [];
          for (const f of shotFiles) screenshots.push(await uploadOne(f, 'screenshots'));
          fill.style.width = '75%';

          setStatus('Обработка и публикация…');
          const res = await fetch('/api/upload', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              apkUrl, screenshots,
              name: $('name').value.trim(),
              developer: $('developer').value.trim(),
              categorySlug: $('category').value,
              description: $('description').value.trim(),
              descriptions,
              webUrl: $('hasWeb').checked ? $('webUrl').value.trim() : '',
              featured: $('featured').checked,
              pinned: $('pinned').checked,
              promoOrder: Number($('promoOrder').value) || 100,
              rating: $('rating').value,
              ratingsCount: $('ratingsCount').value
            })
          });
          const data = await res.json();
          fill.style.width = '100%';
          if (res.ok) {
            setStatus(`Готово: /app/${data.slug}/ (v${data.version || '?'}). Карточка появится после пересборки.`, 'ok');
            $('f').reset();
          } else {
            setStatus(data.error || 'Ошибка публикации', 'err');
          }
        } catch (err) {
          setStatus(err?.message || 'Ошибка загрузки', 'err');
        } finally {
          btn.disabled = false;
          setTimeout(() => { bar.style.display = 'none'; fill.style.width = '0'; }, 1200);
        }
      });
    </script>
  </body>
</html>
