---
export const prerender = false;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>apk4orge · Подборки</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 0; background: #0b1120; color: #e2e8f0; }
      header { display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; border-bottom: 1px solid #1e293b; }
      header b { font-size: 16px; }
      header nav a { color: #94a3b8; font-size: 13px; text-decoration: none; margin-left: 16px; }
      main { max-width: 820px; margin: 0 auto; padding: 24px 20px 80px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .sub { color: #94a3b8; font-size: 13px; margin: 0 0 20px; }
      label { display: block; font-size: 12px; margin: 12px 0 5px; color: #cbd5e1; }
      input, textarea { width: 100%; box-sizing: border-box; border-radius: 9px; border: 1px solid #334155;
        background: #131c31; color: #e2e8f0; padding: 9px 11px; font-size: 14px; font-family: inherit; }
      textarea { min-height: 70px; resize: vertical; }
      .card { border: 1px solid #1e293b; border-radius: 14px; padding: 16px; margin-top: 14px; background: #0f1626; }
      .card .head { display: flex; gap: 10px; align-items: center; }
      .card .head input[type=text] { flex: 1; }
      .row { display: grid; grid-template-columns: 1fr 110px; gap: 10px; align-items: end; }
      .checkrow { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
      .checkrow input { width: 18px; height: 18px; }
      .checkrow label { margin: 0; }
      .langs { margin-top: 10px; border-top: 1px solid #1e293b; padding-top: 6px; }
      .lang { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: .04em; margin-top: 12px; }
      .del { margin-top: 12px; font-size: 13px; padding: 7px 12px; border-radius: 9px; border: 1px solid #7f1d1d;
        background: #131c31; color: #fca5a5; cursor: pointer; }
      .bar { position: sticky; bottom: 0; background: #0b1120; padding: 14px 0; margin-top: 20px; border-top: 1px solid #1e293b;
        display: flex; gap: 12px; align-items: center; }
      button.primary { height: 44px; padding: 0 22px; border: 0; border-radius: 10px; background: #4f46e5;
        color: #fff; font-weight: 600; font-size: 15px; cursor: pointer; }
      button.add { background: #131c31; color: #a5b4fc; border: 1px solid #334155; height: 40px; padding: 0 16px;
        border-radius: 10px; cursor: pointer; font-size: 14px; margin-top: 16px; }
      .status { font-size: 14px; }
      .status.ok { color: #34d399; } .status.err { color: #f87171; }
      .hint { color: #64748b; font-size: 12px; margin-top: 4px; }
    </style>
  </head>
  <body>
    <header>
      <b>apk4orge · подборки</b>
      <nav>
        <a href="/">Добавить</a>
        <a href="/manage">Мои приложения</a>
        <a href="/serp">Позиции</a>
        <a href="#" id="logout">Выйти</a>
      </nav>
    </header>
    <main>
      <h1>Редакционные подборки</h1>
      <p class="sub">Тематические списки («аналоги X», «без слежки», «для Huawei без GMS»). Приложения указывай по slug или package id — по одному в строке. Пустые (без найденных приложений) на сайт не попадают.</p>

      <div id="list"></div>
      <button class="add" id="add">＋ Новая подборка</button>

      <div class="bar">
        <button class="primary" id="save">Сохранить всё</button>
        <span class="status" id="status"></span>
      </div>
    </main>

    <template id="tpl">
      <div class="card">
        <div class="head">
          <input type="text" data-f="slug" placeholder="slug (напр. private-messengers)" />
          <button class="del" data-del type="button">Удалить</button>
        </div>
        <div class="row">
          <div>
            <label>Приложения (slug или package id, по одному в строке)</label>
            <textarea data-f="apps" placeholder="org.telegram.messenger&#10;com.whatsapp"></textarea>
          </div>
          <div>
            <label>Порядок</label>
            <input type="number" data-f="order" value="100" />
            <div class="checkrow">
              <input type="checkbox" data-f="featured" id="" />
              <label>На главную</label>
            </div>
          </div>
        </div>
        <div class="langs" data-langs></div>
      </div>
    </template>

    <script>
      const LANGS = ['ru', 'en', 'tr', 'uz'];
      const $ = (id) => document.getElementById(id);
      const setStatus = (m, k) => { const s = $('status'); s.textContent = m || ''; s.className = 'status ' + (k || ''); };

      $('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/login';
      });

      function addCard(c = {}) {
        const node = $('tpl').content.firstElementChild.cloneNode(true);
        node.querySelector('[data-f="slug"]').value = c.slug || '';
        node.querySelector('[data-f="apps"]').value = (c.apps || []).join('\n');
        node.querySelector('[data-f="order"]').value = c.order ?? 100;
        node.querySelector('[data-f="featured"]').checked = !!c.featured;
        const langs = node.querySelector('[data-langs]');
        for (const lang of LANGS) {
          const t = (c.translations && c.translations[lang]) || {};
          const wrap = document.createElement('div');
          wrap.innerHTML = `
            <div class="lang">${lang}</div>
            <input type="text" data-lang="${lang}" data-lf="title" placeholder="Заголовок (${lang})" />
            <textarea data-lang="${lang}" data-lf="intro" placeholder="Вступительный текст (${lang}). Абзацы — пустой строкой."></textarea>`;
          wrap.querySelector('[data-lf="title"]').value = t.title || '';
          wrap.querySelector('[data-lf="intro"]').value = t.intro || '';
          langs.appendChild(wrap);
        }
        node.querySelector('[data-del]').addEventListener('click', () => node.remove());
        $('list').appendChild(node);
      }

      function collect() {
        return [...$('list').querySelectorAll('.card')].map((card) => {
          const translations = {};
          for (const lang of LANGS) {
            translations[lang] = {
              title: card.querySelector(`[data-lang="${lang}"][data-lf="title"]`).value.trim(),
              intro: card.querySelector(`[data-lang="${lang}"][data-lf="intro"]`).value.trim()
            };
          }
          return {
            slug: card.querySelector('[data-f="slug"]').value.trim(),
            featured: card.querySelector('[data-f="featured"]').checked,
            order: Number(card.querySelector('[data-f="order"]').value) || 100,
            apps: card.querySelector('[data-f="apps"]').value.split(/\r?\n/).map((s) => s.trim()).filter(Boolean),
            translations
          };
        });
      }

      async function load() {
        setStatus('Загрузка…');
        try {
          const res = await fetch('/api/collections');
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка');
          $('list').innerHTML = '';
          (data.collections || []).forEach(addCard);
          if (!(data.collections || []).length) addCard();
          setStatus('');
        } catch (err) { setStatus(err.message || 'Ошибка', 'err'); }
      }

      $('add').addEventListener('click', () => addCard());
      $('save').addEventListener('click', async () => {
        setStatus('Сохранение…');
        try {
          const res = await fetch('/api/collections', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ collections: collect() })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка');
          setStatus(`Сохранено (${data.count}). Появится на сайте после пересборки.`, 'ok');
        } catch (err) { setStatus(err.message || 'Ошибка', 'err'); }
      });

      load();
    </script>
  </body>
</html>
