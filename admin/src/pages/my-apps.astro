---
import { categoryChoices } from '../lib/record.js';
export const prerender = false;
const categories = categoryChoices();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>apk4orge · Массовая загрузка</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 0; background: #0b1120; color: #e2e8f0; }
      header { display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; border-bottom: 1px solid #1e293b; }
      header b { font-size: 16px; }
      header nav a { color: #94a3b8; font-size: 13px; text-decoration: none; margin-left: 16px; }
      main { max-width: 640px; margin: 0 auto; padding: 24px 20px 60px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .sub { color: #94a3b8; font-size: 13px; margin: 0 0 24px; }
      label { display: block; font-size: 13px; margin: 16px 0 6px; color: #cbd5e1; }
      input, select { width: 100%; box-sizing: border-box; border-radius: 10px; border: 1px solid #334155;
        background: #131c31; color: #e2e8f0; padding: 10px 12px; font-size: 15px; font-family: inherit; }
      input[type=file] { padding: 8px; }
      button { margin-top: 24px; width: 100%; height: 46px; border: 0; border-radius: 10px; background: #4f46e5;
        color: #fff; font-weight: 600; font-size: 15px; cursor: pointer; }
      button:disabled { opacity: .6; cursor: default; }
      .hint { color: #64748b; font-size: 12px; margin-top: 4px; }
      .status { margin-top: 18px; font-size: 14px; min-height: 20px; }
      .status.ok { color: #34d399; } .status.err { color: #f87171; }
      .rows { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
      .row { display: flex; gap: 10px; align-items: baseline; padding: 9px 12px; border-radius: 10px;
        border: 1px solid #1e293b; background: #0f1626; font-size: 13px; }
      .row .fn { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .row .st { flex: none; font-size: 12px; }
      .row.wait .st { color: #64748b; }
      .row.work .st { color: #a5b4fc; }
      .row.ok { border-color: #065f46; } .row.ok .st { color: #34d399; }
      .row.dup { border-color: #78350f; } .row.dup .st { color: #fbbf24; }
      .row.err { border-color: #7f1d1d; } .row.err .st { color: #f87171; }
      .row .go { flex: none; color: #a5b4fc; font-size: 12px; text-decoration: none; }
    </style>
  </head>
  <body>
    <header>
      <b>apk4orge · массовая загрузка</b>
      <nav>
        <a href="/">Одно приложение</a>
        <a href="/manage">Мои приложения</a>
        <a href="#" id="logout">Выйти</a>
      </nav>
    </header>
    <main>
      <h1>Загрузить пачку APK</h1>
      <p class="sub">
        Выбери сразу несколько APK — каждый разберётся сам: пакет, версия, вес, минимальный Android,
        SHA-256 и иконка. Карточки создадутся с общей категорией, а название, описание и остальное
        поправишь потом в «Моих приложениях».
      </p>

      <label for="files">APK файлы</label>
      <input id="files" type="file" accept=".apk,application/vnd.android.package-archive" multiple />
      <p class="hint">Название карточки берётся из имени файла — переименуй файлы заранее, будет меньше правок.</p>

      <label for="category">Категория для всей пачки</label>
      <select id="category">
        {categories.map((c) => <option value={c.slug}>{c.label}</option>)}
      </select>
      <p class="hint">Ставится всем сразу. Отдельным карточкам поменяешь в редакторе.</p>

      <button id="go" type="button">Загрузить</button>
      <div class="status" id="status"></div>
      <div class="rows" id="rows"></div>
    </main>

    <script>
      import { upload } from '@vercel/blob/client';

      const $ = (id) => document.getElementById(id);
      const setStatus = (msg, kind) => { const s = $('status'); s.textContent = msg || ''; s.className = 'status ' + (kind || ''); };

      $('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/login';
      });

      /* Имя карточки из имени файла: без .apk, без версии-хвоста, разделители в пробелы. */
      function nameFromFile(fileName) {
        const base = fileName.replace(/\.apk$/i, '').replace(/[._-]+/g, ' ').trim();
        return base.slice(0, 120) || 'Без названия';
      }

      $('files').addEventListener('change', () => {
        const files = [...$('files').files];
        $('rows').innerHTML = files.map((f, i) => `
          <div class="row wait" id="r${i}">
            <span class="fn"></span>
            <span class="st">в очереди</span>
          </div>`).join('');
        files.forEach((f, i) => { $(`r${i}`).querySelector('.fn').textContent = f.name; });
        setStatus(files.length ? `Выбрано файлов: ${files.length}` : '');
      });

      function mark(i, cls, text, href) {
        const row = $(`r${i}`);
        if (!row) return;
        row.className = 'row ' + cls;
        row.querySelector('.st').textContent = text;
        if (href && !row.querySelector('.go')) {
          const a = document.createElement('a');
          a.className = 'go';
          a.href = href;
          a.textContent = 'править';
          row.appendChild(a);
        }
      }

      $('go').addEventListener('click', async () => {
        const files = [...$('files').files];
        if (!files.length) { setStatus('Сначала выбери APK файлы.', 'err'); return; }

        const categorySlug = $('category').value;
        $('go').disabled = true;
        $('files').disabled = true;

        let added = 0, dup = 0, failed = 0;

        /* Строго по одному: каждая карточка — это коммит в data/custom-apps.json,
           а параллельные коммиты конфликтуют по sha и половина пачки потерялась бы. */
        for (const [i, file] of files.entries()) {
          setStatus(`Загружаю ${i + 1} из ${files.length}…`);
          try {
            mark(i, 'work', 'загрузка…');
            const blob = await upload(`apk/${Date.now()}-${file.name}`, file, {
              access: 'public',
              handleUploadUrl: '/api/blob-token'
            });

            mark(i, 'work', 'разбираю APK…');
            const res = await fetch('/api/upload', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                apkUrl: blob.url,
                name: nameFromFile(file.name),
                categorySlug
              })
            });
            const data = await res.json();

            if (res.status === 409) { mark(i, 'dup', 'уже в каталоге'); dup += 1; continue; }
            if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);

            mark(i, 'ok', `v${data.version || '—'}`, `/edit?slug=${encodeURIComponent(data.slug)}`);
            added += 1;
          } catch (err) {
            mark(i, 'err', err.message || 'ошибка');
            failed += 1;
          }
        }

        $('go').disabled = false;
        $('files').disabled = false;

        const parts = [`добавлено: ${added}`];
        if (dup) parts.push(`пропущено дублей: ${dup}`);
        if (failed) parts.push(`с ошибкой: ${failed}`);
        setStatus(parts.join(', ') + '. Сайт пересоберётся за пару минут.', failed ? 'err' : 'ok');
      });
    </script>
  </body>
</html>
