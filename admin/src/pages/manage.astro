---
export const prerender = false;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>apk4orge · Мои приложения</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 0; background: #0b1120; color: #e2e8f0; }
      header { display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; border-bottom: 1px solid #1e293b; }
      header b { font-size: 16px; }
      header nav a { color: #94a3b8; font-size: 13px; text-decoration: none; margin-left: 16px; }
      main { max-width: 760px; margin: 0 auto; padding: 24px 20px 60px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .sub { color: #94a3b8; font-size: 13px; margin: 0 0 20px; }
      .item { display: flex; align-items: center; gap: 12px; padding: 12px; border: 1px solid #1e293b;
        border-radius: 12px; margin-top: 10px; background: #0f1626; }
      .item img { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; background: #1e293b; flex: none; }
      .item .meta { min-width: 0; flex: 1; }
      .item .name { font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .item .small { color: #94a3b8; font-size: 12px; margin-top: 2px; }
      .badges { display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap; }
      .badge { font-size: 11px; padding: 1px 7px; border-radius: 999px; }
      .badge.f { background: #4f46e520; color: #a5b4fc; }
      .badge.p { background: #05966920; color: #6ee7b7; }
      .badge.w { background: #0ea5e920; color: #7dd3fc; }
      .actions { display: flex; gap: 8px; flex: none; }
      .actions a, .actions button { font-size: 13px; padding: 7px 12px; border-radius: 9px; border: 1px solid #334155;
        background: #131c31; color: #e2e8f0; text-decoration: none; cursor: pointer; }
      .actions .del { border-color: #7f1d1d; color: #fca5a5; }
      .status { margin-top: 16px; font-size: 14px; min-height: 20px; }
      .status.err { color: #f87171; }
      .empty { color: #64748b; font-size: 14px; margin-top: 24px; }
      .add { display: inline-block; margin-top: 20px; font-size: 14px; color: #a5b4fc; text-decoration: none; }
    </style>
  </head>
  <body>
    <header>
      <b>apk4orge · мои приложения</b>
      <nav>
        <a href="/">Добавить</a>
        <a href="/collections">Подборки</a>
        <a href="/reviews">Отзывы</a>
        <a href="#" id="logout">Выйти</a>
      </nav>
    </header>
    <main>
      <h1>Мои приложения</h1>
      <p class="sub">Список загруженных тобой карточек. Правь, продвигай или удаляй. Изменения появляются на сайте через 1–2 минуты после пересборки.</p>
      <div id="list"></div>
      <div class="status" id="status">Загрузка…</div>
      <a class="add" href="/">＋ Добавить приложение</a>
    </main>

    <script>
      const $ = (id) => document.getElementById(id);
      const setStatus = (msg, kind) => { const s = $('status'); s.textContent = msg || ''; s.className = 'status ' + (kind || ''); };

      $('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/login';
      });

      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

      async function load() {
        setStatus('Загрузка…');
        try {
          const res = await fetch('/api/apps');
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка загрузки');
          render(data.apps || []);
          setStatus('');
        } catch (err) {
          setStatus(err.message || 'Ошибка', 'err');
        }
      }

      function render(apps) {
        const list = $('list');
        if (!apps.length) { list.innerHTML = '<p class="empty">Пока нет ни одной карточки. Добавь первую.</p>'; return; }
        apps.sort((a, b) => (a.promo_order - b.promo_order) || a.name.localeCompare(b.name));
        list.innerHTML = apps.map((a) => `
          <div class="item" data-slug="${esc(a.slug)}">
            <img src="${esc(a.icon_url)}" alt="" onerror="this.style.visibility='hidden'" />
            <div class="meta">
              <div class="name">${esc(a.name)}</div>
              <div class="small">${esc(a.developer || '—')} · v${esc(a.version || '?')} · /app/${esc(a.slug)}/</div>
              <div class="badges">
                ${a.featured ? '<span class="badge f">Рекомендуем</span>' : ''}
                ${a.pinned ? '<span class="badge p">Закреплён</span>' : ''}
                ${a.web_url ? '<span class="badge w">Веб</span>' : ''}
                <span class="small">порядок: ${esc(a.promo_order)}</span>
              </div>
            </div>
            <div class="actions">
              <a href="/edit?slug=${encodeURIComponent(a.slug)}">Править</a>
              <button class="del" data-del="${esc(a.slug)}" data-name="${esc(a.name)}">Удалить</button>
            </div>
          </div>`).join('');

        list.querySelectorAll('[data-del]').forEach((btn) => {
          btn.addEventListener('click', () => remove(btn.dataset.del, btn.dataset.name));
        });
      }

      async function remove(slug, name) {
        if (!confirm(`Удалить «${name}»? Карточка исчезнет с сайта после пересборки.`)) return;
        setStatus('Удаление…');
        try {
          const res = await fetch('/api/delete', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Ошибка удаления');
          await load();
        } catch (err) {
          setStatus(err.message || 'Ошибка', 'err');
        }
      }

      load();
    </script>
  </body>
</html>
