# --- Admin panel secrets (never commit the real .env) ---

# The single password that unlocks the panel. Pick a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string (>= 16 chars) used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=change-me-to-a-random-32-byte-string

# GitHub token with contents:write on the catalog repo. A fine-grained PAT
# scoped to just this repository (Contents: Read and write) is enough.
GITHUB_TOKEN=github_pat_xxx

# Which repo and branch the new card is committed to. The commit is what
# triggers the four public sites to rebuild.
GITHUB_REPO=angrycoranger-star/apkcatalog
GITHUB_BRANCH=main

# Vercel Blob store token. On Vercel this is injected automatically once a
# Blob store is linked to the project — set it here only for local runs.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Anthropic API key — enables the "Generate with Claude" button that drafts an
# SEO description (all four languages) for your apps. Optional: without it the
# button just returns an error and you write descriptions by hand.
# ANTHROPIC_API_KEY=sk-ant-...
