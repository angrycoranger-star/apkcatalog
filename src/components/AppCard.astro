---
import AppIcon from './AppIcon.astro';
import Rating from './Rating.astro';

/* `variant="rail"` gives the card a fixed width so it can live inside a
   horizontal swipe rail; the default stretches to fill a grid cell. */
const { app, variant = 'grid', eager = false } = Astro.props;
const rail = variant === 'rail';
---

<article
  data-category={app.categorySlug}
  data-rating={app.rating ?? 0}
  data-name={app.name}
  data-updated={app.updatedAt ?? ''}
  class:list={[
    'group relative flex flex-col rounded-2xl border p-3 transition-shadow hover:shadow-md surface',
    rail ? 'h-full w-[10.5rem] sm:w-44' : 'h-full'
  ]}
>
  <div class:list={['flex gap-3', rail ? 'flex-col items-start' : 'items-start']}>
    <AppIcon src={app.icon} alt={app.name} size={rail ? 64 : 56} eager={eager} />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-sm font-semibold leading-tight">
        <a href={app.href} class="after:absolute after:inset-0 after:content-['']">
          {app.name}
        </a>
      </h3>
      <p class="mt-0.5 truncate text-xs text-muted">{app.developer}</p>
      <div class="mt-1.5">
        <Rating value={app.rating} count={rail ? null : app.ratingsCount} />
      </div>
    </div>
  </div>

  {!rail && app.summary && (
    <p class="clamp-2 mt-3 text-xs leading-relaxed text-muted">{app.summary}</p>
  )}

  <div class:list={['mt-auto flex items-center gap-1.5 pt-3 text-[11px]', rail && 'pt-2']}>
    <span class="truncate rounded-full bg-brand-50 px-2 py-0.5 font-medium text-brand-700 dark:bg-brand-500/15 dark:text-brand-300">
      {app.categoryLabel}
    </span>
    {app.size && <span class="shrink-0 text-muted">{app.size}</span>}
  </div>
</article>
