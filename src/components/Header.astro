---
import SearchBox from './SearchBox.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, navHref } from '../i18n/index.js';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: t('nav.home') },
  { href: '/apps/', label: t('nav.apps') },
  { href: '/games/', label: t('nav.games') },
  { href: '/collections/', label: t('nav.collections') }
];
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
/* The homepage hero has its own large search field. */
const showMobileSearch = path !== '/';
---

<header class="sticky top-0 z-40 border-b backdrop-blur surface/95" style="background-color: color-mix(in srgb, var(--surface-raised) 92%, transparent);">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href={navHref('/')} class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-sm font-bold text-white">A</span>
      <span class="hidden sm:inline">{t('site.name')}</span>
    </a>

    <nav aria-label={t('nav.menu')} class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <a
          href={navHref(link.href)}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300'
              : 'text-muted hover:text-brand-600'
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto hidden min-w-0 flex-1 justify-end lg:flex">
      <SearchBox id="header-search" compact />
    </div>

    <div class="ml-auto flex items-center gap-2 lg:ml-2">
      <LanguageSwitcher />

      <details class="relative md:hidden">
        <summary
          class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border surface"
          aria-label={t('nav.menu')}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          aria-label={t('nav.menu')}
          class="absolute right-0 mt-2 w-48 rounded-xl border p-2 shadow-lg surface"
        >
          {links.map((link) => (
            <a href={navHref(link.href)} class="block rounded-lg px-3 py-2 text-sm hover:bg-brand-50 dark:hover:bg-brand-500/10">
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>

  {showMobileSearch && (
    <div class="border-t px-4 py-2 lg:hidden" style="border-color: var(--border);">
      <SearchBox id="mobile-search" compact />
    </div>
  )}
</header>
