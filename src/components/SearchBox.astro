---
import { t } from '../i18n/index.js';

/* Search runs entirely in the browser against /search-index.json, which the
   build emits per language. The index is fetched lazily on first interaction
   so it never costs anything on a page nobody searches from. */
const { id = 'search', compact = false, autofocus = false } = Astro.props;
const listId = `${id}-results`;
---

<div
  class:list={['relative w-full', compact ? 'max-w-md' : 'max-w-2xl']}
  data-search-root
  data-search-empty={t('search.empty')}
  data-search-hint={t('search.hint')}
>
  <label class="sr-only" for={id}>{t('search.label')}</label>
  <div class="relative">
    <svg
      class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted"
      width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
    </svg>
    <input
      id={id}
      type="search"
      role="combobox"
      autocomplete="off"
      aria-expanded="false"
      aria-controls={listId}
      aria-autocomplete="list"
      autofocus={autofocus || undefined}
      placeholder={t('search.placeholder')}
      data-search-input
      class:list={[
        'w-full rounded-xl border bg-transparent pl-10 pr-10 outline-none transition-shadow surface focus:shadow-md',
        compact ? 'h-9 text-sm' : 'h-12 text-base'
      ]}
    />
    <button
      type="button"
      data-search-clear
      hidden
      aria-label={t('search.clear')}
      class="absolute right-2 top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-lg text-muted hover:bg-brand-50 dark:hover:bg-brand-500/10"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <ul
    id={listId}
    role="listbox"
    aria-label={t('search.results')}
    data-search-results
    hidden
    class="absolute left-0 right-0 top-full z-50 mt-2 max-h-96 overflow-y-auto rounded-xl border p-1.5 shadow-xl surface"
  ></ul>
</div>

<script>
  const INDEX_URL = '/search-index.json';
  const MAX_RESULTS = 8;
  let indexPromise = null;

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch(INDEX_URL)
        .then((res) => (res.ok ? res.json() : []))
        .catch(() => []);
    }
    return indexPromise;
  }

  // Case- and diacritic-insensitive so "muzik" finds "Müzik".
  const fold = (value) =>
    value
      .toLocaleLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  function rank(entries, query) {
    const needle = fold(query);
    const scored = [];
    for (const entry of entries) {
      const name = fold(entry.n);
      const dev = fold(entry.d || '');
      let score = -1;
      if (name.startsWith(needle)) score = 0;
      else if (name.includes(needle)) score = 1;
      else if (dev.includes(needle)) score = 2;
      if (score >= 0) scored.push({ entry, score });
    }
    return scored
      .sort((a, b) => a.score - b.score || (b.entry.r ?? 0) - (a.entry.r ?? 0))
      .slice(0, MAX_RESULTS)
      .map((item) => item.entry);
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]
    );
  }

  document.querySelectorAll('[data-search-root]').forEach((root) => {
    const input = root.querySelector('[data-search-input]');
    const list = root.querySelector('[data-search-results]');
    const clear = root.querySelector('[data-search-clear]');
    const emptyText = root.dataset.searchEmpty;
    let active = -1;

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    const render = (results) => {
      if (results.length === 0) {
        list.innerHTML = `<li class="px-3 py-2 text-sm text-muted">${escapeHtml(emptyText)}</li>`;
      } else {
        list.innerHTML = results
          .map(
            (entry, index) => `
            <li role="option" id="opt-${index}" aria-selected="false">
              <a href="/app/${encodeURIComponent(entry.s)}/" class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-brand-50 dark:hover:bg-brand-500/10">
                <img src="${escapeHtml(entry.i || '/img/placeholder-icon.svg')}" alt="" width="36" height="36" loading="lazy" class="h-9 w-9 rounded-lg bg-slate-100 object-cover dark:bg-slate-800" onerror="this.onerror=null;this.src='/img/placeholder-icon.svg'" />
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium">${escapeHtml(entry.n)}</span>
                  <span class="block truncate text-xs text-muted">${escapeHtml(entry.c || '')}${entry.d ? ' · ' + escapeHtml(entry.d) : ''}</span>
                </span>
                ${entry.r ? `<span class="ml-auto shrink-0 text-xs text-muted">★ ${entry.r.toFixed(1)}</span>` : ''}
              </a>
            </li>`
          )
          .join('');
      }
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };

    const run = async () => {
      const query = input.value.trim();
      clear.hidden = query.length === 0;
      if (query.length < 2) return close();
      render(rank(await loadIndex(), query));
    };

    input.addEventListener('focus', loadIndex, { once: true });
    input.addEventListener('input', run);

    clear.addEventListener('click', () => {
      input.value = '';
      clear.hidden = true;
      close();
      input.focus();
    });

    input.addEventListener('keydown', (event) => {
      const options = [...list.querySelectorAll('[role="option"]')];
      if (event.key === 'Escape') return close();
      if (options.length === 0) return;

      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        active = (active + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
        options.forEach((option, index) => {
          option.setAttribute('aria-selected', String(index === active));
          option.firstElementChild?.classList.toggle('bg-brand-50', index === active);
        });
        input.setAttribute('aria-activedescendant', options[active].id);
        options[active].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && active >= 0) {
        event.preventDefault();
        options[active].querySelector('a')?.click();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) close();
    });
  });
</script>
