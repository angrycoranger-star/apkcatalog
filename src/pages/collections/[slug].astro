---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppGrid from '../../components/AppGrid.astro';
import { getCollections, getCollection } from '../../lib/collections.js';
import { t, LANG } from '../../i18n/index.js';

export function getStaticPaths() {
  return getCollections().map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
const paragraphs = collection.intro.split('\n\n').filter(Boolean);
const description = collection.metaDescription || `${collection.title} — ${t('collections.title')}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: collection.title,
    description,
    inLanguage: LANG,
    url: Astro.site ? new URL(`/collections/${collection.slug}/`, Astro.site).href : undefined
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: collection.title,
    numberOfItems: collection.apps.length,
    itemListElement: collection.apps.map((app, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: Astro.site ? new URL(app.href, Astro.site).href : app.href,
      name: app.name
    }))
  }
];
---

<BaseLayout title={collection.title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav aria-label="breadcrumb" class="mb-5 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a class="hover:text-brand-600" href="/">{t('nav.home')}</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-brand-600" href="/collections/">{t('collections.title')}</a></li>
        <li aria-hidden="true">/</li>
        <li>{collection.title}</li>
      </ol>
    </nav>

    <article>
      <header class="max-w-2xl">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{collection.title}</h1>
        <div class="mt-3 space-y-3 text-sm leading-relaxed" style="color: var(--text);">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </header>

      <h2 class="mt-8 mb-3 text-sm font-medium text-muted">{t('collections.count', undefined, { n: collection.apps.length })}</h2>
      <AppGrid apps={collection.apps} id="collection-grid" />
    </article>
  </div>
</BaseLayout>
