---
import CatalogSections from '../../components/CatalogSections.astro';
import { t } from '../../i18n/index.js';
import { HAS_APPS } from '../../lib/apps.js';

/* A thematic build without apps has no listing; send visitors home. */
if (!HAS_APPS) return Astro.redirect('/');
---

<CatalogSections
  title={t('apps.title')}
  subtitle={t('apps.subtitle')}
  description={`${t('apps.subtitle')} — ${t('site.description')}`}
  type="app"
  base="/apps/"
  breadcrumbs={[
    { name: t('nav.home'), href: '/' },
    { name: t('apps.title'), href: '/apps/' }
  ]}
/>
