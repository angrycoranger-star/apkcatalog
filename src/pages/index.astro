---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import Carousel from '../components/Carousel.astro';
import { t } from '../i18n/index.js';
import { popularApps, topRatedApps, recentApps, usedCategories, getAllApps } from '../lib/apps.js';

const popular = popularApps(14);
const topRated = topRatedApps(14);
const recent = recentApps(14);
const gameCategories = usedCategories('game');
const appCategories = usedCategories('app');
const total = getAllApps().length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('site.name'),
  description: t('site.description'),
  url: Astro.site?.href,
  inLanguage: Astro.currentLocale
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="border-b bg-gradient-to-b from-brand-50 to-transparent px-4 py-12 dark:from-brand-500/10" style="border-color: var(--border);">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('home.hero.title')}</h1>
      <p class="mx-auto mt-3 max-w-xl text-sm text-muted sm:text-base">{t('home.hero.subtitle')}</p>
      <div class="mt-6 flex justify-center">
        <SearchBox id="hero-search" />
      </div>
      <p class="mt-3 text-xs text-muted">{t('list.count')}: {total}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl pb-4">
    {popular.length > 0 && (
      <Carousel id="popular" title={t('home.popular')} apps={popular} moreHref="/apps/" />
    )}
    {topRated.length > 0 && (
      <Carousel id="top-rated" title={t('home.topRated')} apps={topRated} moreHref="/games/" />
    )}

    <section class="mt-12 px-4" aria-labelledby="categories-title">
      <h2 id="categories-title" class="text-lg font-semibold tracking-tight sm:text-xl">{t('home.categories')}</h2>

      <h3 class="mt-5 text-sm font-medium text-muted">{t('home.gameCategories')}</h3>
      <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {gameCategories.map((entry) => (
          <li>
            <a
              href={`/games/${entry.category.slug}/`}
              class="flex items-center justify-between rounded-xl border px-3 py-2.5 text-sm transition-colors hover:border-brand-400 surface"
            >
              <span class="truncate">{entry.label}</span>
              <span class="ml-2 shrink-0 text-xs text-muted">{entry.count}</span>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="mt-6 text-sm font-medium text-muted">{t('home.appCategories')}</h3>
      <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {appCategories.map((entry) => (
          <li>
            <a
              href={`/apps/${entry.category.slug}/`}
              class="flex items-center justify-between rounded-xl border px-3 py-2.5 text-sm transition-colors hover:border-brand-400 surface"
            >
              <span class="truncate">{entry.label}</span>
              <span class="ml-2 shrink-0 text-xs text-muted">{entry.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {recent.length > 0 && (
      <Carousel id="recent" title={t('home.newApps')} apps={recent} moreHref="/apps/" />
    )}
  </div>
</BaseLayout>
