---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import { t } from '../i18n/index.js';
---

<BaseLayout title={t('error.404.title')} description={t('error.404.text')} noindex>
  <div class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="text-5xl font-bold text-brand-600">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">{t('error.404.title')}</h1>
    <p class="mt-2 text-sm text-muted">{t('error.404.text')}</p>
    <div class="mt-8 flex justify-center"><SearchBox id="notfound-search" /></div>
    <a href="/" class="mt-8 inline-block rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">
      {t('error.404.cta')}
    </a>
  </div>
</BaseLayout>
