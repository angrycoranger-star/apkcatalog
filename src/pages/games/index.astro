---
import CatalogPage from '../../components/CatalogPage.astro';
import { getGames, usedCategories, sortApps } from '../../lib/apps.js';
import { t } from '../../i18n/index.js';

const apps = sortApps(getGames(), 'rating');
---

<CatalogPage
  title={t('games.title')}
  subtitle={t('games.subtitle')}
  description={`${t('games.subtitle')} — ${t('site.description')}`}
  apps={apps}
  categories={usedCategories('game')}
  base="/games/"
  breadcrumbs={[
    { name: t('nav.home'), href: '/' },
    { name: t('games.title'), href: '/games/' }
  ]}
/>
