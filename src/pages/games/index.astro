---
import CatalogSections from '../../components/CatalogSections.astro';
import { t } from '../../i18n/index.js';
import { HAS_GAMES } from '../../lib/apps.js';

/* A thematic build without games has no listing; send visitors home. */
if (!HAS_GAMES) return Astro.redirect('/');
---

<CatalogSections
  title={t('games.title')}
  subtitle={t('games.subtitle')}
  description={`${t('games.subtitle')} — ${t('site.description')}`}
  type="game"
  base="/games/"
  breadcrumbs={[
    { name: t('nav.home'), href: '/' },
    { name: t('games.title'), href: '/games/' }
  ]}
/>
