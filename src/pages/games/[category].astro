---
import CatalogPage from '../../components/CatalogPage.astro';
import { getGames, usedCategories, sortApps } from '../../lib/apps.js';
import { t } from '../../i18n/index.js';

export function getStaticPaths() {
  return usedCategories('game').map((entry) => ({
    params: { category: entry.category.slug },
    props: { label: entry.label }
  }));
}

const { category } = Astro.params;
const { label } = Astro.props;
const apps = sortApps(getGames().filter((game) => game.categorySlug === category), 'rating');
---

<CatalogPage
  title={label}
  subtitle={`${t('games.title')} · ${label}`}
  description={`${label} — ${t('games.subtitle')}.`}
  apps={apps}
  categories={usedCategories('game')}
  base="/games/"
  activeSlug={category}
  breadcrumbs={[
    { name: t('nav.home'), href: '/' },
    { name: t('games.title'), href: '/games/' },
    { name: label, href: `/games/${category}/` }
  ]}
/>
