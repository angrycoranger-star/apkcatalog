---
import BaseLayout from './BaseLayout.astro';
import { t, formatDate } from '../i18n/index.js';
import { LEGAL_UPDATED } from '../i18n/legal.js';

const { title, sections, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h1>
    <p class="mt-2 text-sm text-muted">{t('legal.updated')}: {formatDate(LEGAL_UPDATED)}</p>

    <div class="mt-8 space-y-8">
      {sections.map((section) => (
        <section>
          <h2 class="text-lg font-semibold tracking-tight">{section.h}</h2>
          {section.p.map((paragraph) => (
            <p class="mt-2 text-sm leading-relaxed text-muted">{paragraph}</p>
          ))}
        </section>
      ))}
      <slot />
    </div>
  </div>
</BaseLayout>
