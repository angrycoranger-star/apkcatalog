# Language for this build. One of: ru, en, tr
SITE_LANG=ru

# Bare domain; subdomains are derived as ru.<domain>, en.<domain>, tr.<domain>
SITE_DOMAIN=apk4orge.com

# Contact address printed on the legal and contact pages.
# Keep the PUBLIC_ prefix so Astro exposes it to the build.
PUBLIC_CONTACT_EMAIL=hello@apk4orge.com

# Per-app subdomains. Off by default: app pages live at <lang>.<domain>/app/<slug>/.
# Set to 1 to address each app at <slug>.<lang>.<domain> instead (the edge
# middleware serves the built page there). Only turn on once the wildcard domain
# *.<lang>.<domain> and its DNS/SSL exist on the hosting side.
# PUBLIC_APP_SUBDOMAINS=1

# Reviews service. Empty = the reviews block is hidden. Point it at the admin
# deployment (which hosts the public /api/reviews endpoint) to turn on visitor
# comments and user ratings, e.g. https://apk4orge-admin.vercel.app
# PUBLIC_API_BASE=https://apk4orge-admin.vercel.app

# --- Google SERP monitor (scripts/serp-monitor.js) ---
# Telegram bot that receives the daily "what moved" report. Create the bot via
# @BotFather, then send it any message and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Leave both blank to run the
# monitor without notifications (the report still prints and is committed).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Outbound proxy for the scans, e.g. http://user:pass@host:port. Only needed
# once Google starts answering with captchas from the runner's IP; requires the
# `undici` package to be installed.
# SERP_PROXY=
